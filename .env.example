# Environment configuration for the Port A app.
#
# Two-env-file pattern (see CLAUDE.md → "Local development"):
#
#   .env.local              — prod Supabase values. Loaded in all modes
#                             unless a mode-specific file overrides. Used by
#                             local `npm run build` for prod-like local
#                             builds.
#   .env.development.local  — local Supabase values (`supabase start`).
#                             Overrides .env.local in dev mode.
#
# Both are gitignored. On a fresh checkout, copy this file to .env.local and
# fill in your prod project values from Supabase Dashboard → Project Settings
# → API. Then run `supabase start` and `npm run dev` — the dev server will
# pick up .env.development.local automatically (or you can create it from the
# `supabase status -o env` output).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Owner identity surfaced on the Pending/Denied screens ("email <owner> to
# nudge them"). Both optional but recommended — without VITE_OWNER_EMAIL the
# mailto link is suppressed; without VITE_OWNER_NAME the screens derive a
# personable name from the email local-part, falling back to "the admin".
#
# NOTE: there is also a hardcoded email in supabase/migrations/0001_init.sql
# (the `handle_new_user` trigger that auto-admins on first sign-in). Forkers
# must edit that line before applying migrations, OR wait for the planned
# follow-up that moves it to an `app_config` table.
VITE_OWNER_EMAIL=you@example.com
VITE_OWNER_NAME=Your First Name

# TrackHS guest portal auto-login link for the condo. This is a bearer
# credential (anyone with the link gets in), so keep it in .env.local
# only — never in .env.example or .env.development.local. If unset,
# CondoPortalCard renders a "not configured" hint instead of a button.
#
# Gotcha: .env files treat `#` as a start-of-comment, so the bare
# `vrp.trackhs.com/guest/#!/login/...` form silently truncates to
# `vrp.trackhs.com/guest/`. Use the `email.trackhs.com/CL0/...`
# wrapper (which encodes the `#` as `%23`), or URL-encode the `#`
# yourself, or quote the entire value with double quotes.
VITE_CONDO_PORTAL_URL=https://email.trackhs.com/CL0/...
