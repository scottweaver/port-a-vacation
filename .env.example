# Environment configuration for the Port A app.
#
# Two-env-file pattern (see CLAUDE.md → "Local development"):
#
#   .env.local              — prod Supabase values. Loaded in all modes
#                             unless a mode-specific file overrides. Used by
#                             local `npm run build` for prod-like local
#                             builds.
#   .env.development.local  — local Supabase values (`supabase start`).
#                             Overrides .env.local in dev mode.
#
# Both are gitignored. On a fresh checkout, copy this file to .env.local and
# fill in your prod project values from Supabase Dashboard → Project Settings
# → API. Then run `supabase start` and `npm run dev` — the dev server will
# pick up .env.development.local automatically (or you can create it from the
# `supabase status -o env` output).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# TrackHS guest portal auto-login link for the condo. This is a bearer
# credential (anyone with the link gets in), so keep it in .env.local
# only — never in .env.example or .env.development.local. If unset,
# CondoPortalCard renders a "not configured" hint instead of a button.
VITE_CONDO_PORTAL_URL=https://vrp.trackhs.com/guest/#!/login/...
